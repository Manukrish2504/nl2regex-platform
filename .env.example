# Copy to .env beside docker-compose.prod.yml and fill in. .env is git-ignored.
# Every value marked REQUIRED has no default: the stack refuses to start without it and says
# which one is missing, rather than running on a key that is printed in this repository.

# --- REQUIRED ---------------------------------------------------------------------------

# The hostname the certificate is for. "localhost" makes Caddy issue a local one, which is how
# this stack is tested on a laptop; a real name makes it ask Let's Encrypt.
SITE_HOST=nl2regex.example.com

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# The key the users' AWS credentials are encrypted with before they reach Redis.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Shared by the Spark driver, master and workers. Anything reaching the master without it is
# refused, and the RPC that carries the users' AWS keys is encrypted.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SPARK_AUTH_SECRET=

# Flower shows every task and can revoke them, so it asks for a password. One line, user:password.
FLOWER_BASIC_AUTH=flower:choose-something

# --- OPTIONAL ---------------------------------------------------------------------------

# Without it, describing a pattern in plain English is switched off and everything else works.
# Set a monthly spending limit in the Anthropic console as well: the limits below bound abuse,
# but that one is the only cap this server cannot be talked out of.
ANTHROPIC_API_KEY=

LLM_MODEL=claude-opus-5
LLM_RATE_PER_CONNECTION=30/hour
LLM_RATE_PER_SERVER=200/day
JOB_MAX_FILE_BYTES=5000000000

# How many Spark applications may run at once. Give each one its share of the cluster's cores
# with SPARK_CORES_MAX, or the first job takes them all and the rest wait.
JOB_CONCURRENCY=1
SPARK_CORES_MAX=
SPARK_WORKERS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
WEB_WORKERS=3
